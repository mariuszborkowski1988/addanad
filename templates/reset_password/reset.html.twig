{% extends 'base.html.twig' %}

{% block title %}Reset your password{% endblock %}


{% block body %}

    <div id="reset-page" class="login-page">
    <div class="container-login">

    {# Background Image #}
    <div class="login-bg-img">
        <img src="{{ asset('img/bg/reset_03.jpg') }}" alt="Reset background image">
    </div>

    <div class="row-login">
        <div class="login-form-wrapper">

            {{ form_start(resetForm) }}
                <div class="title-website-box">
                    <h1 class="text-center"><b><a href="{{ path('app_main') }}">Add An Ad</a></b></h1>
                    <p class="text-center">Miejsce na Twoje ogłoszenie.</p>
                </div>

                <h2 class="h3 mb-4 font-weight-normal d-flex justify-content-center align-items-center"><b>Reset your password</b></h2>

                <div class="form-floating mb-3">
                    {{ form_row(resetForm.plainPassword) }}


                </div>

                <button class="btn btn-lg btn-primary w-100">Reset password</button>

            {{ form_end(resetForm) }}
        </div>
    </div>

    </div>{# end .container-login #}
    </div>{# end #reset-page.login-page #}


{% endblock %}
