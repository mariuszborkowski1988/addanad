{% extends 'base.html.twig' %}

{% block title %}Reset your password{% endblock %}

{% block body %}

        <div id="reset-page" class="login-page">
        <div class="container-login">

        {# Background Image #}
        <div class="login-bg-img">
            <img src="{{ asset('img/bg/reset_01.jpg') }}" alt="Reset background image">
        </div>

        <div class="row-login">
            <div class="login-form-wrapper">



                <div class="title-website-box pt-3 pb-5">
                    <h1 class="text-center"><b><a href="{{ path('app_main') }}">Add An Ad</a></b></h1>
                    <p class="text-center">Miejsce na Twoje ogłoszenie.</p>
                </div>

                <h2 class="h3 mb-4 font-weight-normal d-flex justify-content-center align-items-center"><b>Reset your password</b></h2>

                {% for flash_error in app.flashes('reset_password_error') %}
                    <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
                {% endfor %}

                {{ form_start(requestForm, {
                    attr: {
                        'class': 'reset-request-form'
                    }
                })
                }}


                <div class="form-floating mb-3">
                    {{ form_widget(requestForm.email, {
                        attr: {
                            'class': 'form-control'
                        }
                    })
                    }}
                    {{ form_label(requestForm.email, null, {
                        'label': 'Your email'
                    }) }}
                </div>

                <div class="pb-3">

                        Enter your email address, and we will send you a
                        link to reset your password.

                </div>

                <button class="btn btn-lg btn-primary w-100">Send password reset email</button>

                {{ form_end(requestForm) }}
            </div>
        </div>

        </div>{# end .container-login #}
        </div>{# end #login-page.login-page #}

{% endblock %}
