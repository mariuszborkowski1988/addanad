{% extends 'base.html.twig' %}

{% block title %}Register{% endblock %}

{% block body %}

    <section id="register-page" class="register-page">
        <div class="container-register">
            <div class="register-bg-img">
                <img src="{{ asset('img/bg/register_bg.jpg') }}" alt="Background"/>
            </div>



            <div class="row-register">
                <div class="register-form-wrapper">


                    <div class="title-website-box">
                        <h1 class="text-center"><b><a href="{{ path('app_main') }}">Add An Ad</a></b></h1>
                        <p class="text-center">Miejsce na Twoje ogłoszenie.</p>
                    </div>


                        {% for flash_error in app.flashes('verify_email_error') %}
                            <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
                        {% endfor %}

                        <h2 class="text-center pt-3 pb-3">Zarejestruj się</h2>

                        {{ form_errors(registrationForm) }}

                        {{ form_start(registrationForm, {
                            attr: {
                                'class': 'register-form'
                                }
                            })
                        }}
                        <div class="form-floating mb-3">
                            {{ form_widget(registrationForm.email, {
                                    attr: {
                                        'class': 'form-control'
                                    }
                                })
                            }}
                            {{ form_label(registrationForm.email, null, {
                                'label': 'Your email'
                            }) }}
                        </div>

                        <div class="form-floating mb-3">
                            {{ form_widget(registrationForm.plainPassword, {
                                attr: {
                                    'class': 'form-control'
                                }
                            })
                            }}
                            {{ form_label(registrationForm.plainPassword, null, {
                                'label': 'Password'
                            }) }}
                           {# {{ form_row(registrationForm.agreeTerms) }}#}
                        </div>

                        <button type="submit" class="btn btn-lg btn-primary w-100">Register</button>
                        {{ form_end(registrationForm) }}

                        <p class="pt-3"><a href="{{ path('app_login') }}">Masz konto? <span>Zaloguj się!</span></a></p>

                </div>
            </div>

        </div>{# end .container-register #}
    </section>{# end section#register-page.register-page #}


{% endblock %}
