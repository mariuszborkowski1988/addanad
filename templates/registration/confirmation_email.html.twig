{% extends 'base.html.twig' %}

{% block title %}Register{% endblock %}

{% block body %}

    <section id="register-page" class="register-page">
    <div class="container-register">
    <div class="register-bg-img">
        <img src="{{ asset('img/bg/register_bg.jpg') }}" alt="Background"/>
    </div>

    <div class="row-register">
        <div class="register-form-wrapper">


            <div class="title-website-box">
                <h1 class="text-center"><b><a href="{{ path('app_main') }}">Add An Ad</a></b></h1>
                <p class="text-center">Miejsce na Twoje ogłoszenie.</p>
            </div>
            <h2 class="text-center pt-3 pb-3">Hi! Please confirm your email!</h2>

            <p>
                Please confirm your email address by clicking the following link: <br><br>
                <a href="{{ signedUrl|raw }}">Confirm my Email</a>.
                This link will expire in {{ expiresAtMessageKey|trans(expiresAtMessageData, 'VerifyEmailBundle') }}.
            </p>

            <p>
                Cheers!
            </p>


        </div>
    </div>

    </div>{# end .container-register #}
    </section>{# end section#register-page.register-page #}


{% endblock %}
