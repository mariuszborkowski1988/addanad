{# Header content #}
<section id="header-content" class="header-content">
    <div class="img-bg-header">
        <img src="{{ asset('img/img_main_header.jpg') }}" alt="Header Image" class="img-fluid mb-4">
    </div>
    <div class="container">
        <div class="header-content-text">
            <h1 class="mb-0">Welcome to Add An Ad -
                {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                    {{ app.user.email }}
                {% else %}
                    Guest
                {% endif %} </h1>
            <p class="pt-0 pb-5">Your one-stop solution for posting and finding ads.</p>
            <form class="d-flex" role="search">


                <div class="input-group">

                    <input class="form-control form-control-lg w-50" type="search" placeholder="Search" aria-label="Search"/>

                    <select class="form-select w-25 form-control-lg">
                        <option selected>Wybierz kategorię</option>
                        <option value="1">Mieszkania</option>
                        <option value="2">Działki</option>
                        <option value="3">Domy</option>
                        <option value="4">Pokoje</option>
                        <option value="5">Motoryzacja</option>
                        <option value="6">Elektronika</option>
                        <option value="7">Moda</option>
                        <option value="8">Praca</option>
                    </select>
                    <label class="input-group-text form-control-lg rounded-0">Wybierz Kategorię</label>
                </div>

                <button id="add-main-page-search-button" class="btn-light border-1 rounded-end pe-4 ps-4 text-black-50" type="submit">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </button>
            </form>
        </div>
    </div>
</section>
